[Unit]
Description=Handover (controlled side, lite build)
After=systemd-user-sessions.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/lib/handover/handover --service
Restart=on-failure
RestartSec=5
# The service starts the user's --server and the approval proof (sudo) as children; stopping the
# service must end all of them.
KillMode=control-group
TimeoutStopSec=30
LimitNOFILE=100000

[Install]
WantedBy=multi-user.target
