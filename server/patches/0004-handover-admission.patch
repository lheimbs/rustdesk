+// Handover: admission by tokens signed by the owner's issuer (libs/handover_cred). The servers refuse to
+// start without HANDOVER_CA_PUB; HANDOVER_REVOKED optionally names a file of revoked serials.
+static HANDOVER_GATE: std::sync::OnceLock<handover_cred::token::Gate> = std::sync::OnceLock::new();
+static HANDOVER_LAST_LOG: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static HANDOVER_SUPPRESSED: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+pub fn handover_gate_init() -> ResultType<()> {
+    let gate = handover_cred::token::Gate::from_env()
+        .map_err(|e| hbb_common::anyhow::anyhow!("admission is not configured: {e}"))?;
+    let _ = HANDOVER_GATE.set(gate);
+    log::info!("admission: only clients with credentials signed by the configured issuer are served");
+    Ok(())
+}
+
+/// Is this token a fresh, unrevoked one of an allowed role for exactly this message? Failures are logged,
+/// at most one line per second (the rest is counted) so that an attacker cannot flood the log.
+pub fn handover_admit(token: &str, kind: &str, context: &str, roles: &[handover_cred::Role], from: &str) -> bool {
+    use std::sync::atomic::Ordering::Relaxed;
+    let Some(gate) = HANDOVER_GATE.get() else { return false };
+    match gate.check(token, kind, context, roles) {
+        Ok(_) => true,
+        Err(e) => {
+            let now = handover_cred::token::now_secs();
+            if HANDOVER_LAST_LOG.swap(now, Relaxed) != now {
+                let n = HANDOVER_SUPPRESSED.swap(0, Relaxed);
+                log::warn!("admission refused ({kind}) from {from}: {e}{}", if n > 0 { format!(" [+{n} more in the last second]") } else { String::new() });
+            } else {
+                HANDOVER_SUPPRESSED.fetch_add(1, Relaxed);
+            }
+            false
+        }
+    }
+}
