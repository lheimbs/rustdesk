[Unit]
Description=Handover rendezvous server (hbbs)
After=network-online.target
Wants=network-online.target

[Service]
# Create the user once: useradd --system --home /var/lib/handover-server --shell /usr/sbin/nologin handover
User=handover
Group=handover
WorkingDirectory=/var/lib/handover-server
Environment=RUST_LOG=info
# Admission: only clients with credentials signed by this issuer key are served (public key from `handover-ca init`);
# serials listed in the revocation file (one per line, # comments) are refused, re-read within seconds.
Environment=HANDOVER_CA_PUB=@CA_PUB@
Environment=HANDOVER_REVOKED=/var/lib/handover-server/revoked.txt
# -k _ : generate/use id_ed25519 in the working directory and refuse clients that do not carry its public key.
# -r   : host:port of hbbr as clients should reach it (your overlay-network/LAN address).
ExecStart=/usr/local/bin/hbbs -k _ -r @RELAY_HOST@
Restart=on-failure
RestartSec=3

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/handover-server
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
# Only your own networks may talk to the server (HANDOVER_ALLOWED_NETS in .env); everything else is dropped.
IPAddressDeny=any
IPAddressAllow=@ALLOWED_NETS@

[Install]
WantedBy=multi-user.target
