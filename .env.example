# Copy to .env (git-ignored) and fill in. Nothing here is ever committed.
# Read by: cargo builds (build.rs), tools/build-windows.ps1, server/render-units.sh.

# --- Client build: baked into the binary -------------------------------------
# Host (or IP) of your hbbs, as clients reach it.
HANDOVER_RENDEZVOUS_SERVER=
# Contents of your hbbs id_ed25519.pub (base64, 44 characters ending in '=').
HANDOVER_SERVER_KEY=
# Public key of your issuer (printed by `handover-ca init`). Only controllers holding a credential signed by
# the matching secret key can connect to a client built with it. Never put the secret key anywhere near a build.
HANDOVER_CONTROLLER_CA=
# Optional: a device credential for the machines you give out (output of `handover-ca compact <device.cred>`). It lets
# them register with your servers; it is shared by every machine built with it, so for per-customer revocation put a
# device.cred file in each machine's config directory instead.
HANDOVER_DEVICE_CRED=

# --- Server units (server/render-units.sh) -----------------------------------
# host:port of hbbr as clients reach it; usually the same host as hbbs, port 21117.
HANDOVER_RELAY_HOST=
# Networks allowed to talk to hbbs/hbbr (systemd IPAddressAllow syntax, space separated).
HANDOVER_ALLOWED_NETS="127.0.0.0/8 ::1/128"
